#
# Shared shell profile
#
# Add this to the approriate shell profile:
# # Source shared shell profile
# if [ -f ~/.shell_profile ]; then
#    . ~/.shell_profile
# fi

# 
# NOTE: setting env vars should go in .profile
# https://askubuntu.com/questions/279285/why-profile-and-not-bashrc-appends-bin-to-path
#

# Useful appends to PATH
# First check they are not already present
case ":$PATH:" in
    *":$HOME/bin:"*) ;;
    *) export PATH="$HOME/bin:$PATH" ;;
esac

#
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Set pager to less
export PAGER="less"

# Default editor settings
export VISUAL=vim
export EDITOR="$VISUAL"

# Set directory to store tmux sockets
export TMUX_TMPDIR="$HOME/tmp"

#
# zsh specific config
#
if [ -n "$ZSH_VERSION" ]; then

    # Wait time (cs) for additional characters when you press a key that starts a multi-key sequence.
    # e.g. Esc
    export KEYTIMEOUT=10

fi

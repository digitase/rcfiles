# Some more ls aliases
# -F: classify entries
# -a all
# -l long format
# -tr sort by time, reverse sort
alias l='ls -Fa'
alias ll='ls -Fal'
alias lll='ls -Faltr'

# For vimcom/vim-r-plugin
# alias vim="vim --servername VIM"

# Force tmux to assume the terminal supports 256 colours.
alias tmux="tmux -2"

# Default wide layout for bjobs
# alias bjobs='bjobs -w'

# Gets fresh environment variables for tmux
function tmux_refresh_env_vars {
    if [ -n "$TMUX"  ]; then
        export $(tmux show-environment | grep "^DISPLAY")
    fi
}

# List active tmux sockets
function tmux_get_active_sockets {
    for tmux_socket_path in $(lsof -U | grep '^tmux' | awk '{print $9}'); do
        echo "$tmux_socket_path"
        printf '\t%s\n' "$(tmux -S $tmux_socket_path ls)"
    done
}

# Restart a dead tmux server
function tmux_restart_server {
    if [ -z "$1" ]; then
        echo No server name specified.
        return
    fi
    tmux_process=$(ps ux | grep tmux | grep "\-L $1" | awk '{print $2}')
    echo kill -10 PID: "$tmux_process"
    kill -10 "$tmux_process"
    tmux_get_active_sockets
}

